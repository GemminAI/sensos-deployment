{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "core-release-manifest/0",
  "title": "Core Release Manifest v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_version", "release_id", "repositories", "packages"],
  "properties": {
    "manifest_version": {"const": "core-release-manifest/0"},
    "release_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "decisions": {"type": "array", "items": {"type": "string", "pattern": "^D-[0-9]+$"}},
    "note": {"type": "string"},
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "url", "branch", "commit"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "url": {"type": "string", "pattern": "^https://"},
          "branch": {"type": "string", "minLength": 1},
          "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "expected_version": {"type": "string", "minLength": 1}
        }
      }
    },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version", "wheel_sha256"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "version": {"type": "string", "minLength": 1},
          "wheel_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
